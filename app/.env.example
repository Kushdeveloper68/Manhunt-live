# Mobile App Environment Variables
# Real phone: use your PC's WiFi IP (hostname -I / ipconfig), NOT 10.0.2.2 (that only works in the Android emulator)
EXPO_PUBLIC_API_URL=http://192.168.1.23:4000/api
# Optional: if omitted, the socket uses EXPO_PUBLIC_API_URL without "/api"
EXPO_PUBLIC_SOCKET_URL=http://192.168.1.23:4000
# Map tiles: leave unset to use OpenFreeMap (free, streets). Do NOT use demotiles.maplibre.org: it is a tiny world map without streets.
# EXPO_PUBLIC_MAP_STYLE_URL=https://api.maptiler.com/maps/dataviz-dark/style.json?key=YOUR_KEY
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com
# DEV ONLY: use the fake Google button (server must also set ALLOW_DEV_GOOGLE_MOCK=true)
EXPO_PUBLIC_ALLOW_DEV_GOOGLE_MOCK=false

# Emergency number shown on the SOS screen (India: 112)
EXPO_PUBLIC_EMERGENCY_NUMBER=112
