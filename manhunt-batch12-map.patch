+
+  pinBox: { width: 150, height: 72, alignItems: 'center' },
+  dot: { position: 'absolute', top: 28, width: 16, height: 16, borderRadius: 8, borderWidth: 2, borderColor: '#FFFFFF' },
+  ring: {
+    position: 'absolute',
+    top: 22,
+    width: 28,
+    height: 28,
+    borderRadius: 14,
+    borderWidth: 2,
+    alignItems: 'center',
+    justifyContent: 'center',
+  },
+  ringCore: { width: 8, height: 8, borderRadius: 4 },
+  sosDot: {
+    position: 'absolute',
+    top: 20,
+    width: 32,
+    height: 32,
+    borderRadius: 16,
+    backgroundColor: '#FF1744',
+    alignItems: 'center',
+    justifyContent: 'center',
+    borderWidth: 2,
+    borderColor: '#FFFFFF',
+  },
+  sosText: { color: '#FFFFFF', fontSize: 10, fontWeight: '900' },
+  labelWrap: {
+    position: 'absolute',
+    top: 52,
+    maxWidth: 150,
+    backgroundColor: 'rgba(10,10,10,0.8)',
