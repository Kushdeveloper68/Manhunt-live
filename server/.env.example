# Server Configuration
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/manhunt_dev

# Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRES_IN=7d

# Google OAuth
# Comma-separated OAuth client IDs (web + android) allowed to sign in. REQUIRED for Google login.
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com
# DEV ONLY: accept unverified Google logins from the app's mock button. Ignored in production.
ALLOW_DEV_GOOGLE_MOCK=false

# Map Tile Provider (MapLibre style JSON URL)
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Client URLs (CORS)
CLIENT_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081
