# Server Configuration
PORT=4000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/manhunt_dev

# Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Map Tile Provider (MapLibre style JSON URL)
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Client URLs (CORS)
CLIENT_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081
